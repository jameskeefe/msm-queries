<h1> Movie #<%= @id_num %> details</h1>

<div> <a href="/movies/">Go back</a> </div>

<hr>

<div>
<dt> Title </dt>
<dd> <%= @m.title %> </dd>

<dt> Year </dt>
<dd> <%= @m.year %> </dd>

<dt> Duration </dt>
