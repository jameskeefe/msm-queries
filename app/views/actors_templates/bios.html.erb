<h1> Actor #<%= @id_num %> details</h1>

<div> <a href="/actors/">Go back</a> </div>

<hr>

<div>
<dt> Name </dt>
<dd> <%= @a.name %> </dd>

<dt> Dob </dt>
<dd> <%= @a.dob %> </dd>

<dt> Bio </dt>
<dd> <%= @a.bio %> </dd>

<dt> Image </dt>
<dd> <img src="<%=@a.image%>" width=300> </dd>

<dt> Created at: </dt>
<dd> <%= @a.created_at %>

<dt> Updated at: </dt>
<dd> <%= @a.updated_at %>

</div>

<hr>

<h1>Filmography</h1>

<div>

<table border=1>
  <tr>
    <th>Title</th>
    <th>Year</th>
    <th>Director</th>
    <th>Character name</th>
    <th></th>
  </tr>

<% Character.where(:actor_id => @id_num).each do |c| %>
  <% m = Movie.where(:id => c.movie_id).at(0) %>
  <% d = Director.where(:id => m.director_id).at(0) %>
  <tr>
    <td> <%= m.title %> </td>
    <td> <%= m.year %> </td>
    <td> <%= d.name %> </td>
    <td> <%= c.name %> </td>
    <td> <a href="/movies/<%= m.id %>">Show details</a> </td>
  </tr>
<% end %>
</table>

</div>
